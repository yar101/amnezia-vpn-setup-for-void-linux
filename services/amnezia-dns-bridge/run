#!/bin/sh
exec 2>&1
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
if [ ! -f /opt/AmneziaVPN/bin/amnezia-dns-bridge ]; then
    echo "[amnezia-dns-bridge] Binary /opt/AmneziaVPN/bin/amnezia-dns-bridge not found. Pausing..."
    pause 2>/dev/null || sleep 10
    exit 1
fi
exec /usr/bin/python3 -u /opt/AmneziaVPN/bin/amnezia-dns-bridge
